,"2682":"u","2683":"u","2687":"u","2688":"n","2921":"u","3056":"u","3057":"u","3058":"u","3191":"u","3192":"u","3193":"u","3324":"u","3327":"u","3328":"u","3354":"u","3450":"u","3451":"u","3720":"u","3721":"u","3722":"u","3723":"u","3855":"u","3856":"u","3857":"u","3866":"u","3867":"u","3868":"u","3915":"u","3976":"u","3977":"u","3978":"u","4030":"u","4031":"u","4032":"u","4033":"u","4035":"u","4036":"u","4037":"u","4038":"u"},"id":["freq","unit","landcover","geo","time"],"size":[1,2,15,27,5],"dimension":{"freq":{"label":"Time frequency","category":{"index":{"A":0},"label":{"A":"Annual"}}},"unit":{"label":"Unit of measure","category":{"index":{"KM2":0,"PC":1},"label":{"KM2":"Square kilometre","PC":"Percentage"}}},"landcover":{"label":"Land cover","category":{"index":{"TOTAL":0,"A00":1,"A10":2,"A20":3,"A30":4,"B00":5,"C00":6,"C10":7,"C20":8,"C30":9,"D00":10,"E00":11,"F00":12,"G00":13,"H00":14},"label":{"TOTAL":"Total area","A00":"Artificial land","A10":"Built-up area","A20":"Artificial, non built-up area","A30":"Other artificial areas","B00":"Cropland","C00":"Woodland","C10":"Broadleaved woodland","C20":"Coniferous woodland","C30":"Mixed woodland","D00":"Shrubland","E00":"Grassland","F00":"Bare land","G00":"Water","H00":"Wetland"}}},"geo":{"label":"Geopolitical entity (reporting)","category":{"index":{"BE":0,"BG":1,"CZ":2,"DK":3,"DE":4,"EE":5,"IE":6,"EL":7,"ES":8,"FR":9,"HR":10,"IT":11,"CY":12,"LV":13,"LT":14,"LU":15,"HU":16,"MT":17,"NL":18,"AT":19,"PL":20,"PT":21,"RO":22,"SI":23,"SK":24,"FI":25,"SE":26},"label":{"BE":"Belgium","BG":"Bulgaria","CZ":"Czechia","DK":"Denmark","DE":"Germany","EE":"Estonia","IE":"Ireland","EL":"Greece","ES":"Spain","FR":"France","HR":"Croatia","IT":"Italy","CY":"Cyprus","LV":"Latvia","LT":"Lithuania","LU":"Luxembourg","HU":"Hungary","MT":"Malta","NL":"Netherlands","AT":"Austria","PL":"Poland","PT":"Portugal","RO":"Romania","SI":"Slovenia","SK":"Slovakia","FI":"Finland","SE":"Sweden"}}},"time":{"label":"Time","category":{"index":{"2009":0,"2012":1,"2015":2,"2018":3,"2022":4},"label":{"2009":"2009","2012":"2012","2015":"2015","2018":"2018","2022":"2022"}}}},"extension":{"lang":"EN","description":"<p>Land cover statistics describe the area of the various land cover classes recorded in the LUCAS survey. In this context, land cover is defined as the physical cover (“material”) observed at the Earth’s surface. It includes artificial areas, cropland, woodland, grassland, bare land, water and wetland, with detailed classes for specific crop types, building structures and vegetation forms. The statistics are reported for the LUCAS survey years 2009, 2012, 2015, 2018 and 2022, and cover the eight main land cover categories together with their sub-categories. The data are expressed in square kilometres (km²) and as a percentage of the total area of each NUTS 2 region. A coefficient of variation is also provided as an indicator of sampling uncertainty.</p>","id":"LAN_LCV_OVW","agencyId":"ESTAT","version":"1.0","datastructure":{"id":"LAN_LCV_OVW","agencyId":"ESTAT","version":"29.0"},"annotation":[{"type":"CREATED","date":"2013-10-09T08:25:41+0200"},{"type":"DISSEMINATION_DOI_XML","title":"<adms:identifier xmlns:adms=\"http://www.w3.org/ns/adms#\" xmlns:skos=\"http://www.w3.org/2004/02/skos/core.html\" xmlns:dct=\"http://purl.org/dc/terms/\" xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\"><adms:Identifier rdf:about=\"https://doi.org/10.2908/LAN_LCV_OVW\"><skos:notation rdf:datatype=\"http://purl.org/spar/datacite/doi\">10.2908/LAN_LCV_OVW</skos:notation><dct:creator rdf:resource=\"http://publications.europa.eu/resource/authority/corporate-body/ESTAT\"/><dct:issued rdf:datatype=\"http://www.w3.org/2001/XMLSchema#date\">2023-01-19</dct:issued></adms:Identifier></adms:identifier>"},{"type":"DISSEMINATION_EXPLANATORY_LINK","title":"text-category","href":"https://ec.europa.eu/eurostat/databrowser-backend/api/public/explanatory-notes/get/Info_note_LAN_20250604.pdf","text":"Information note"},{"type":"DISSEMIN